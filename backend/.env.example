APP_PORT=8080
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=latihan_chatbot
DB_SSLMODE=disable

AGENT_URL=http://127.0.0.1:8082
AGENT_API_KEY=
AGENT_BATAS_STREAM_MENIT=10

SESI_HARI=30
BATAS_TAMU_PER_JAM=10
BATAS_PESAN_PER_MENIT=20
SESI_TAMU_JAM=10
BATAS_AKUN_PER_MENIT=10
BATAS_PESAN_GLOBAL_PER_MENIT=60
BATAS_PESAN_TAMU=5
# password salah per email sebelum masuk ke email itu dikunci selama JEDA_GAGAL_MASUK_MENIT; 0 = mati
BATAS_GAGAL_MASUK=5
JEDA_GAGAL_MASUK_MENIT=15
# jatah token AI (masuk + keluar) per 24 jam, dihitung dari catatan kinerja (perlu KINERJA_SIMPAN_HARI > 0); 0 = mati.
# AKUN berlaku untuk tiap akun dan tamu (admin tidak dibatasi), SEMUA untuk jumlah seluruh pengguna
BATAS_TOKEN_HARIAN_AKUN=1000000
BATAS_TOKEN_HARIAN_SEMUA=0
# captcha Cloudflare Turnstile untuk masuk akun; kosong = mati.
# Site key-nya diisi di frontend (VITE_TURNSTILE_SITE_KEY). TURNSTILE_URL kosong = alamat resmi Cloudflare
TURNSTILE_SECRET=
TURNSTILE_URL=
ADMIN_EMAIL=

# verifikasi email; EMAIL_LAYANAN saat ini mendukung: brevo. Kosongkan agar akun baru langsung aktif (untuk local)
EMAIL_LAYANAN=
EMAIL_API_KEY=
EMAIL_PENGIRIM=
NAMA_PENGIRIM=Vokapas
FRONTEND_URL=http://localhost:5173
# kirim jawaban ke email akun sendiri bila diminta di chat (perlu EMAIL_LAYANAN); 0 = mati
EMAIL_JAWABAN_PER_HARI=5

# unggah berkas PDF, DOCX, atau teks untuk dibaca chatbot; 0 = mati
BERKAS_MAKS_MB=5
BATAS_BERKAS_PER_JAM=20

# percakapan panjang: bila pesan yang belum diringkas mencapai RINGKASAN_SETELAH_PESAN (maks 20),
# pesan lama diringkas AI dan hanya RINGKASAN_SISA_PESAN pesan terbaru yang dikirim utuh; 0 = mati
RINGKASAN_SETELAH_PESAN=20
RINGKASAN_SISA_PESAN=10

# catatan lama, token, dan alat setiap jawaban untuk menu admin "Kinerja jawaban"; lama disimpan (hari), 0 = mati
KINERJA_SIMPAN_HARI=30
# ya = admin melihat potongan pertanyaan dan jawaban yang diberi "tidak suka"; tidak = hanya jumlahnya
KINERJA_TAMPILKAN_ISI=ya
# jumlah baris per halaman tabel "Terbaru" (maksimal 100)
KINERJA_BARIS_PER_HALAMAN=20
# jumlah baris paling banyak di daftar "Alat paling sering dipakai"
KINERJA_BARIS_ALAT=15

INGESTION_PORT=8081
INGESTION_API_KEY=

WORKER_INTERVAL_MENIT=1440

EKSPOR_FOLDER=ekspor
EKSPOR_URL=
EKSPOR_KUNCI=
EKSPOR_DRIVE_FOLDER=

GERBANG_LOCAL_PORT=8090
GERBANG_LOCAL_KUNCI=
GERBANG_LOCAL_TUJUAN=http://127.0.0.1:11434

#Tunnel untuk jalankan-local.ps1: tailscale atau ngrok
TUNNEL_PENYEDIA=tailscale
TAILSCALE_PATH=