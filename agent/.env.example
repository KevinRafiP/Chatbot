AGENT_HOST=127.0.0.1
AGENT_PORT=8082
AGENT_API_KEY=
# "local" atau "aws"
LLM_PROVIDER=aws

AWS_AUTH_MODE=iam
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-3
# pencarian makna data pengetahuan: aws, api, atau local; kosong = mati
EMBED_PROVIDER=api
# kosong = bawaan penyedia: aws cohere.embed-multilingual-v3, api gemini-embedding-2, local bge-m3
EMBED_MODEL=
# aws: Jakarta belum punya model embedding, jadi wilayahnya dipisah
EMBED_REGION=ap-southeast-1
# api: Gemini, atau layanan lain yang berformat OpenAI /embeddings; kunci kosong = API_KEY
EMBED_API_URL=https://generativelanguage.googleapis.com/v1beta
EMBED_API_KEY=
# local: Ollama (ollama pull bge-m3), langsung atau lewat gerbang local/ngrok; kosong = LOCAL_URL dan LOCAL_API_KEY
EMBED_LOCAL_URL=
EMBED_LOCAL_API_KEY=
# kemiripan minimal 0 sampai 1; kosong = bawaan penyedia (aws 0.35, api 0.55, local 0.45)
EMBED_SKOR_MINIMAL=

LLM_MODEL=moonshotai.kimi-k2.5
# model untuk mode cepat, kosong = sama dengan LLM_MODEL
LLM_MODEL_CEPAT=
# model untuk chat tamu, kosong = sama dengan LLM_MODEL_CEPAT
# dipakai sekali jika model utama gagal atau timeout, kosong = tanpa cadangan
LLM_MODEL_CADANGAN=

#API apa saja selain aws, etc Gemini
API_URL=https://generativelanguage.googleapis.com/v1beta/openai
API_KEY=
API_MODEL=gemini-3.8-flash

#API jika menggunakan LLM lokal
LOCAL_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=llama3.2
#Kunci gerbang Ollama, kosongkan jika Ollama dipanggil langsung tanpa gerbang
LOCAL_API_KEY=
LOCAL_MAKS_LANGKAH=3
LOCAL_MAKS_BACA_URL=1

AGENT_WAJIB_CARI=ya
AGENT_VERIFIKASI_JAWABAN=ya
LOCAL_VERIFIKASI_JAWABAN=tidak
LOCAL_WAJIB_CARI=tidak

TAVILY_KEDALAMAN=advanced
TAVILY_API_KEY=

AGENT_MAKS_LANGKAH=6
AGENT_MAKS_BACA_URL=3
CEPAT_MAKS_LANGKAH=3
CEPAT_MAKS_BACA_URL=1
TAMU_MAKS_LANGKAH=2
TAMU_MAKS_BACA_URL=1
AGENT_BATAS_WAKTU_DETIK=15
AGENT_DOMAIN_DIBLOKIR=
LLM_MODEL_TAMU=
# cache hasil pencarian di memori; diganti jika pengguna bilang salah atau minta cari ulang
CACHE_CARI=ya
CACHE_CARI_JAM=24
CACHE_CARI_MAKS=500

# alat tambahan; nama alat dipisah koma untuk dimatikan: waktu_tanggal,konversi,keuangan,kalkulus,acak,info_lokasi,info_hiburan,wikipedia,cari_pengetahuan,kirim_email
ALAT_MATI=
ALAT_USER_AGENT=Vokapas/1.0 (chatbot)
# ya = alat khusus hanya dikirim jika pertanyaannya cocok (hemat token); tidak = semua alat selalu dikirim
ALAT_SESUAI_PERTANYAAN=ya
# setiap alamat API bisa diisi mati untuk mematikan fitur itu; kosong = alamat bawaan
GEOKODE_API_URL=
LIBUR_API_URL=
# frankfurter (data Bank Sentral Eropa) atau exchangerate (open.er-api.com)
KURS_PROVIDER=frankfurter
KURS_API_URL=
KURS_CACHE_MENIT=60
CUACA_API_URL=
SALAT_API_URL=
# 20 = Kementerian Agama RI
SALAT_METODE=20
GEMPA_API_URL=
RUTE_API_URL=
WILAYAH_API_URL=
GAME_API_URL=
ANIME_API_URL=
# bahasa bawaan Wikipedia: id, en, ja, ms, jv, su; mati = alat wikipedia mati
WIKIPEDIA_BAHASA=id
# alamat backend untuk cari_pengetahuan; di Render diisi otomatis oleh mulai.sh, lokal http://127.0.0.1:8080
BACKEND_URL=
# kosong = AGENT_API_KEY
BACKEND_API_KEY=
KALKULUS_BATAS_DETIK=10
BERKAS_MAKS_HURUF=20000